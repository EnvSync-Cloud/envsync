# =============================================================================
# EnvSync Production Environment Variables
# Copy to .env and fill in every blank value before docker-compose.prod.yaml.
# Compose exits when a required password, client secret, or key path is empty.
# Do not point the paths below at docker/minikms/*.dev.pem (development fixtures).
# Atrium config and clients: docker/atrium/config.prod.example.yaml and
# docker/atrium/clients.prod.example.json. The management client secret in the
# Atrium config must match ATRIUM_MANAGEMENT_CLIENT_SECRET, and the database
# password in that config must match ATRIUM_DB_PASSWORD.
# =============================================================================

# --- App (API) ---
NODE_ENV=production
PORT=4000
DB_LOGGING=false
DB_AUTO_MIGRATE=false
DATABASE_SSL=false

# --- Database (PostgreSQL) ---
# These are internal to the Docker network; no need to expose ports
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=envsync
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=envsync

# --- S3 / RustFS ---
S3_BUCKET=envsync-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_URL=http://rustfs:9000
S3_ENDPOINT=http://rustfs:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# --- Redis ---
CACHE_ENV=production
REDIS_URL=redis://redis:6379

# --- SMTP (use a real SMTP provider in production) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@yourdomain.com

# --- Atrium (IdP). Issuer is the site root. ---
ATRIUM_IMAGE=ghcr.io/bravo68web/atrium:0.2.0-rc.16
ATRIUM_PORT=8080
ATRIUM_DB_PASSWORD=
ATRIUM_CONFIG_PATH=
ATRIUM_CLIENTS_PATH=
ATRIUM_INTERNAL_URL=http://atrium:8080
ATRIUM_PUBLIC_URL=https://auth.yourdomain.com
ATRIUM_ISSUER=https://auth.yourdomain.com
ATRIUM_MANAGEMENT_CLIENT_ID=management
ATRIUM_MANAGEMENT_CLIENT_SECRET=
ATRIUM_WEB_CLIENT_ID=envsync-web
ATRIUM_WEB_CLIENT_SECRET=
ATRIUM_CLI_CLIENT_ID=envsync-cli
ATRIUM_API_CLIENT_ID=envsync-api
ATRIUM_API_CLIENT_SECRET=
ATRIUM_WEB_REDIRECT_URI=https://api.yourdomain.com/api/access/web/callback
ATRIUM_WEB_CALLBACK_URL=https://app.yourdomain.com/auth/callback
ATRIUM_API_REDIRECT_URI=https://api.yourdomain.com/api/access/api/callback

# --- URLs (public-facing) ---
LANDING_PAGE_URL=https://yourdomain.com
DASHBOARD_URL=https://app.yourdomain.com

# --- OpenFGA (authorization engine) ---
OPENFGA_API_URL=http://openfga:8090
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPENFGA_DB_PASSWORD=

# --- miniKMS (encryption key management) ---
# TLS is required when NODE_ENV is not development.
# The API rejects MINIKMS_TLS_INSECURE=true outside development.
MINIKMS_ROOT_KEY=
MINIKMS_GRPC_ADDR=minikms:50051
MINIKMS_TLS_ENABLED=true
MINIKMS_TLS_INSECURE=false
MINIKMS_TLS_CA_CERT_FILE=/run/secrets/minikms-grpc-ca-cert
MINIKMS_TLS_CLIENT_CERT_FILE=/run/secrets/minikms-grpc-client-cert
MINIKMS_TLS_CLIENT_KEY_FILE=/run/secrets/minikms-grpc-client-key
# Host paths mounted by docker-compose.prod.yaml. Do not use *.dev.pem fixtures.
MINIKMS_SESSION_SIGNING_KEY_PATH=
MINIKMS_ROOT_CA_CERT_PATH=
MINIKMS_ROOT_CA_KEY_PATH=
MINIKMS_GRPC_CA_CERT_PATH=
MINIKMS_GRPC_SERVER_CERT_PATH=
MINIKMS_GRPC_SERVER_KEY_PATH=
MINIKMS_GRPC_CLIENT_CERT_PATH=
MINIKMS_GRPC_CLIENT_KEY_PATH=
MINIKMS_DB_USER=postgres
MINIKMS_DB_PASSWORD=

# --- ClickStack / OTEL ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-agent:4318
OTEL_SERVICE_NAME=envsync-api
OTEL_SDK_DISABLED=false
CLICKSTACK_URL=https://obs.yourdomain.com
