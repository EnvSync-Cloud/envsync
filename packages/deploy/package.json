{
  "name": "@envsync-cloud/deploy",
  "version": "0.26.0-rc.6",
  "description": "OSS CLI for self-hosted EnvSync deployment on Docker Swarm",
  "type": "module",
  "bin": {
    "envsync-deploy": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepack": "bun run build",
    "check:pack": "npm pack --dry-run",
    "test": "bun run build && bun test",
    "test:startup-order-60s": "RUN_STARTUP_ORDER_60S=1 bun test src/startup-order-60s.fixture.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnvSync-Cloud/envsync.git",
    "directory": "packages/deploy"
  },
  "homepage": "https://github.com/EnvSync-Cloud/envsync/tree/main/packages/deploy#readme",
  "bugs": {
    "url": "https://github.com/EnvSync-Cloud/envsync/issues"
  },
  "author": "EnvSync Cloud Private Limited",
  "license": "MIT",
  "keywords": [
    "envsync",
    "deploy",
    "self-hosted",
    "docker-swarm",
    "cli",
    "secrets",
    "oss"
  ],
  "dependencies": {
    "age-encryption": "^0.3.1",
    "chalk": "^5.6.2",
    "yaml": "^1.10.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@envsync-cloud/deploy-core": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
